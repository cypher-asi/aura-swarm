#!/bin/bash
# Configuration for aura-swarm infrastructure deployment
# Source this file before running deploy scripts

#------------------------------------------------------------------------------
# AWS Configuration
#------------------------------------------------------------------------------
export AWS_REGION="${AWS_REGION:-us-east-2}"
export AWS_PROFILE="${AWS_PROFILE:-default}"

#------------------------------------------------------------------------------
# Project Configuration
#------------------------------------------------------------------------------
export PROJECT_NAME="${PROJECT_NAME:-aura-swarm}"
export ENVIRONMENT="${ENVIRONMENT:-dev}"

# Resource naming prefix (PROJECT_NAME-ENVIRONMENT)
export RESOURCE_PREFIX="${PROJECT_NAME}-${ENVIRONMENT}"

#------------------------------------------------------------------------------
# EKS Configuration
#------------------------------------------------------------------------------
export EKS_VERSION="${EKS_VERSION:-1.31}"
export EKS_CLUSTER_NAME="${RESOURCE_PREFIX}-cluster"

# Node group configuration
# Using m5.2xlarge for nested virtualization support (Kata/Firecracker)
export NODE_INSTANCE_TYPE="${NODE_INSTANCE_TYPE:-m5.2xlarge}"
# System pool needs headroom during the rollout (CoCo operator + daemonsets +
# platform + any legacy agents still on this pool before R2/R3). Step 11 shrinks
# it back at R3 cleanup. Sizing history: 2 nodes were CPU-request-saturated; 3
# was still ~97% once the full Peer Pods stack runs (CAA + kata-deploy + fuse +
# guest-pull DaemonSets, each per-node, plus gateway/scheduler/control and the
# Trustee KBS), leaving no slot for KBS to (re)schedule. 4 gives real headroom.
export NODE_DESIRED_COUNT="${NODE_DESIRED_COUNT:-4}"
export NODE_MIN_COUNT="${NODE_MIN_COUNT:-1}"
export NODE_MAX_COUNT="${NODE_MAX_COUNT:-5}"

# Note: confidential agents run as Peer Pods (per-agent AWS-managed SEV-SNP pod
# VMs launched off-cluster by CAA). There is no on-node confidential node pool;
# the kata-remote shim + agent-protocol-forwarder run on the workers above.

#------------------------------------------------------------------------------
# Networking Configuration (from spec 08-networking.md)
#------------------------------------------------------------------------------
export VPC_CIDR="${VPC_CIDR:-10.0.0.0/16}"
export PUBLIC_SUBNET_CIDR="${PUBLIC_SUBNET_CIDR:-10.0.1.0/24}"
export PRIVATE_SUBNET_CIDR="${PRIVATE_SUBNET_CIDR:-10.0.2.0/24}"
export AGENT_SUBNET_CIDR="${AGENT_SUBNET_CIDR:-10.0.3.0/24}"
export STORAGE_SUBNET_CIDR="${STORAGE_SUBNET_CIDR:-10.0.4.0/24}"

#------------------------------------------------------------------------------
# ECR Repositories
#------------------------------------------------------------------------------
export ECR_REPO_GATEWAY="${RESOURCE_PREFIX}-gateway"
export ECR_REPO_CONTROL="${RESOURCE_PREFIX}-control"
export ECR_REPO_SCHEDULER="${RESOURCE_PREFIX}-scheduler"
export ECR_REPO_HARNESS="${RESOURCE_PREFIX}-harness"

#------------------------------------------------------------------------------
# Kubernetes Namespaces
#------------------------------------------------------------------------------
export K8S_NAMESPACE_SYSTEM="swarm-system"
export K8S_NAMESPACE_AGENTS="swarm-agents"

#------------------------------------------------------------------------------
# Container Images
#------------------------------------------------------------------------------
export IMAGE_TAG="${IMAGE_TAG:-latest}"

# aura-harness (agent reasoning engine) lives in a separate repo. Step 06
# (06-build-harness.sh) clones + builds + pushes it and pins the digest.
# Override HARNESS_REPO_PATH to build a local checkout instead of cloning, or
# set AURA_HARNESS_IMAGE=<registry>/...@sha256:... to skip the build entirely.
export HARNESS_REPO_URL="${HARNESS_REPO_URL:-https://github.com/cypher-asi/aura-harness}"
export HARNESS_REF="${HARNESS_REF:-main}"

#------------------------------------------------------------------------------
# Test-agent owner login (steps 07/08)
#------------------------------------------------------------------------------
# Steps 07/08 verify a real owner agent through the gateway's user API, which
# needs an owner JWT. The scripts obtain one via a persistent zOS email/password
# login (mirrors aura-os) and cache it — gitignored — in deploy/.smoke-session.jwt,
# so repeated soak runs reuse the session until it expires.
#
# AUTH_BASE_URL MUST match the gateway's AUTH_BASE_URL (the zOS API it
# introspects tokens against). Login hits ${AUTH_BASE_URL}/api/v2/accounts/login.
export AUTH_BASE_URL="${AUTH_BASE_URL:-https://zosapi.zero.tech}"
# Optional non-interactive credentials (e.g. CI). Prefer exporting these from
# your shell or a gitignored .env over committing them here. When unset and a
# TTY is available, the scripts prompt for them. A pre-minted token still wins:
# set SMOKE_TEST_TOKEN (env) or .secrets/SMOKE_TEST_TOKEN to skip login entirely.
# export SMOKE_TEST_EMAIL="owner@example.com"
# export SMOKE_TEST_PASSWORD="..."
#
# Designated owner test agent. Step 07 creates this agent (if absent) and KEEPS
# it; step 08 reuses it by name. Every tier is a confidential SEV-SNP Peer Pod
# (kata-remote), so this is a real per-agent pod-VM cost that lives for the soak
# window. Step 08 --ephemeral reverts to the old create-and-destroy behavior.
export SMOKE_AGENT_NAME="${SMOKE_AGENT_NAME:-r1-owner-soak}"
export SMOKE_AGENT_TIER="${SMOKE_AGENT_TIER:-standard}"

#------------------------------------------------------------------------------
# Agent Isolation
#------------------------------------------------------------------------------
# "confidential_vm" - Confidential SEV-SNP VM via Peer Pods (CAA kata-remote):
#                     a per-agent AWS-managed SEV-SNP pod VM. The production
#                     level for all agents.
# "container"       - Standard container isolation (runc), dev/testing only.
#
# Defaults to "confidential_vm": agents are granted a root-capable dev
# environment (see scheduler pod security context), which is only safe
# behind the confidential guest kernel boundary. Override to "container"
# ONLY on dev clusters without CoCo/CAA, where agents stay locked-down/non-root.
export DEFAULT_ISOLATION="${DEFAULT_ISOLATION:-confidential_vm}"

# Confidential agents always use the CAA `kata-remote` runtime (Peer Pods); the
# scheduler derives this from the ConfidentialVM isolation level. There is no
# on-node runtime to choose, so there is no runtime switch.

#------------------------------------------------------------------------------
# Peer Pods / Cloud API Adaptor (CAA)
#------------------------------------------------------------------------------
# Pinned CAA Helm chart version. This is the `peerpods` OCI chart version
# (oci://ghcr.io/confidential-containers/cloud-api-adaptor/charts/peerpods),
# NOT the old CoCo-operator release train.
# 0.3.1 (appVersion v0.21.1) is the first chart that supports keyless IRSA auth
# for the AWS provider (upstream PR #3059) AND exposes the
# daemonset.serviceAccount.annotations hook step 03 uses to wire the IRSA role.
# Earlier charts (0.1.x/0.2.x) only support static AWS_ACCESS_KEY_ID secrets.
# List published versions:
#   helm show chart oci://ghcr.io/confidential-containers/cloud-api-adaptor/charts/peerpods --version <v>
export CAA_CHART_VERSION="${CAA_CHART_VERSION:-0.3.1}"
# The 0.3.1 chart pins a CAA image (appVersion v0.21.1) whose entrypoint predates
# the IRSA-aware credential check and still hard-requires static AWS keys (it
# CrashLoops with "$AWS_ACCESS_KEY_ID is NOT set" even under IRSA). The IRSA
# entrypoint (one_of AWS_SECRET_ACCESS_KEY/AWS_ROLE_ARN) is only on the dev
# image, so override the chart's image to a build that has it. "latest" (built
# from main) works today; pin to a dev-<sha> / @sha256 digest for reproducibility
# once verified. Set CAA_IMAGE_TAG="" to use the chart's pinned (static-keys) image.
export CAA_IMAGE_NAME="${CAA_IMAGE_NAME:-quay.io/confidential-containers/cloud-api-adaptor}"
export CAA_IMAGE_TAG="${CAA_IMAGE_TAG:-latest}"
# Number of peer-pod VMs CAA advertises per worker as the
# kata.peerpods.io/vm extended resource. The peer-pods webhook rewrites each
# kata-remote pod to request one unit; if CAA does not advertise this capacity,
# mutated pods stay Pending with "Insufficient kata.peerpods.io/vm".
export CAA_PEERPODS_LIMIT_PER_NODE="${CAA_PEERPODS_LIMIT_PER_NODE:-10}"
# CAA advertises kata.peerpods.io/vm only ONCE per pod at startup (it never
# reconciles), so a flaky CAA restart can leave a worker with no capacity. When
# true, ./03-coco-operator.sh self-heals: if workers still don't advertise the
# resource after a CAA rollout restart, it patches nodes/status directly to
# CAA_PEERPODS_LIMIT_PER_NODE so kata-remote pods can schedule. Set false to
# fail instead (e.g. to force investigating why CAA itself isn't advertising).
export CAA_SELF_ADVERTISE_VM_CAPACITY="${CAA_SELF_ADVERTISE_VM_CAPACITY:-true}"
# Peer-pods mutating webhook. REQUIRED for correct peer-pod scheduling: it
# rewrites every pod with runtimeClassName=kata-remote to DROP its cpu/memory
# requests and instead request the kata.peerpods.io/vm extended resource (whose
# capacity each node advertises, default 10). Without it, confidential agent
# pods carry their literal cpu/memory and compete for real worker CPU, so they
# go Unschedulable ("Insufficient cpu") on busy nodes even though the workload
# actually runs off-cluster in the pod VM. Defaults ON; needs cert-manager.
export CAA_ENABLE_WEBHOOK="${CAA_ENABLE_WEBHOOK:-true}"
# Cloud API Adaptor serves a per-node remote-hypervisor socket
# (/run/peerpod/hypervisor.sock) that the kata-remote shim dials to boot a pod
# VM; a node whose adaptor never bound it fails every kata-remote pod sandbox
# instantly (stuck ContainerCreating). Step 03 verifies/heals this.
#   all = require EVERY worker to serve it (default). A real agent's pod is
#         placed by the scheduler and can land on ANY worker, so all nodes must
#         be able to host it — otherwise agent creation is a coin flip. Step 03
#         clean-restarts (maxSurge=0, no port collision) any node missing it.
#   one = stop as soon as ONE node serves the socket — ONLY safe for step 05's
#         smoke test, which pins its throwaway pod to that one healthy node.
export CAA_HYPERVISOR_SOCKET_REQUIRE="${CAA_HYPERVISOR_SOCKET_REQUIRE:-all}"
# cert-manager issues the webhook's TLS certs. Step 03 auto-installs it (pinned
# CERT_MANAGER_VERSION) when the webhook is enabled and the CRDs are absent.
# Set CAA_AUTO_INSTALL_CERT_MANAGER=false to manage cert-manager yourself.
export CAA_AUTO_INSTALL_CERT_MANAGER="${CAA_AUTO_INSTALL_CERT_MANAGER:-true}"
export CERT_MANAGER_VERSION="${CERT_MANAGER_VERSION:-v1.16.2}"
export CERT_MANAGER_NAMESPACE="${CERT_MANAGER_NAMESPACE:-cert-manager}"
# AWS-managed SEV-SNP "pod VM" image + instance type (one EC2 instance per agent).
# PODVM_AMI_ID is auto-discovered by ./configure.sh when left empty. With both
# overrides below empty, discovery looks (in AWS_REGION) for the CoCo community
# published image podvm-fedora-amd64-<CAA_CHART_VERSION> (dots->dashes), then any
# podvm-fedora-amd64-*, then a self-built podvm-*. Set to pin a specific image.
export PODVM_AMI_ID="${PODVM_AMI_ID:-ami-014293f1e632a338a}"
export PODVM_INSTANCE_TYPE="${PODVM_INSTANCE_TYPE:-m6a.large}"
# Optional discovery overrides: PODVM_AMI_OWNERS (space-separated account ids or
# "self"; empty = search all visible, including public community AMIs) and
# PODVM_AMI_NAME_FILTER (an EC2 name filter, * allowed; when set, it overrides
# the smart candidates above and is used verbatim).
export PODVM_AMI_OWNERS="${PODVM_AMI_OWNERS:-}"
export PODVM_AMI_NAME_FILTER="${PODVM_AMI_NAME_FILTER:-}"
# Networking between the worker shim and the pod VM.
export CAA_VXLAN_PORT="${CAA_VXLAN_PORT:-9000}"
export CAA_FORWARDER_PORT="${CAA_FORWARDER_PORT:-15150}"

#------------------------------------------------------------------------------
# Terraform Configuration
#------------------------------------------------------------------------------
export TF_STATE_BUCKET="${RESOURCE_PREFIX}-terraform-state"
export TF_STATE_REGION="${AWS_REGION}"
export TF_STATE_KEY="terraform.tfstate"

#------------------------------------------------------------------------------
# Separation-of-duties IAM (step 01 — IAM Identity Center / SSO)
#------------------------------------------------------------------------------
# Two Identity Center permission sets, each runnable by exactly one user:
#   org-admin  → ALL IAM (cluster/node/CAA roles, OIDC provider, policy grants).
#                Owns + runs ./01-iam.sh only. Needs Identity Center admin.
#   ops-admin  → everything else (terraform infra, EKS, ECR, EFS, kubectl,
#                helm, docker). No IAM-write perms; just a scoped iam:PassRole
#                + iam:Get*/List* on the cluster/node role ARNs.
#
# org-admin provisions BOTH customer-managed policies and attaches each to its
# permission set; the CAA IRSA role + OIDC provider are created on a
# cluster-aware re-run of ./01-iam.sh AFTER ./02-snp-node-group.sh creates the
# cluster (the CAA trust policy references the cluster OIDC issuer).
export ORG_SSO_PERMISSION_SET="${ORG_SSO_PERMISSION_SET:-Org-Identity-Admin}"
export OPS_SSO_PERMISSION_SET="${OPS_SSO_PERMISSION_SET:-Ops-Resources-Admin}"
export ORG_IAM_POLICY="${ORG_IAM_POLICY:-${RESOURCE_PREFIX}-org-admin}"
export OPS_IAM_POLICY="${OPS_IAM_POLICY:-${RESOURCE_PREFIX}-ops-admin}"
# Prefixes of the AWSReservedSSO_* roles provisioned from each permission set
# (used only to locate role ARNs for the permission simulation in step 01).
export ORG_IAM_SSO_ROLE_PREFIX="${ORG_IAM_SSO_ROLE_PREFIX:-AWSReservedSSO_${ORG_SSO_PERMISSION_SET}}"
export OPS_IAM_SSO_ROLE_PREFIX="${OPS_IAM_SSO_ROLE_PREFIX:-AWSReservedSSO_${OPS_SSO_PERMISSION_SET}}"

#------------------------------------------------------------------------------
# Script Directory (auto-detected)
#------------------------------------------------------------------------------
export DEPLOY_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PROJECT_ROOT="$(cd "${DEPLOY_DIR}/.." && pwd)"
