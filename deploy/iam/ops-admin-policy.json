{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EKSClusterAndNodegroups",
      "Effect": "Allow",
      "Action": [
        "eks:Describe*",
        "eks:List*",
        "eks:CreateCluster",
        "eks:DeleteCluster",
        "eks:CreateNodegroup",
        "eks:DeleteNodegroup",
        "eks:UpdateNodegroupConfig",
        "eks:UpdateNodegroupVersion",
        "eks:CreateAddon",
        "eks:UpdateAddon",
        "eks:DeleteAddon",
        "eks:TagResource",
        "eks:UntagResource",
        "eks:AssociateEncryptionConfig",
        "eks:UpdateClusterConfig",
        "eks:UpdateClusterVersion",
        "eks:AccessKubernetesApi"
      ],
      "Resource": [
        "arn:aws:eks:__AWS_REGION__:__AWS_ACCOUNT_ID__:cluster/__EKS_CLUSTER_NAME__",
        "arn:aws:eks:__AWS_REGION__:__AWS_ACCOUNT_ID__:nodegroup/__EKS_CLUSTER_NAME__/*",
        "arn:aws:eks:__AWS_REGION__:__AWS_ACCOUNT_ID__:addon/__EKS_CLUSTER_NAME__/*"
      ]
    },
    {
      "Sid": "EKSUpdatePolling",
      "Effect": "Allow",
      "Action": [
        "eks:DescribeUpdate",
        "eks:ListUpdates"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ScopedPassClusterAndNodeRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::__AWS_ACCOUNT_ID__:role/__RESOURCE_PREFIX__-eks-cluster-role",
        "arn:aws:iam::__AWS_ACCOUNT_ID__:role/__RESOURCE_PREFIX__-eks-node-role"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "eks.amazonaws.com",
            "ec2.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "ReadRolesForTerraformDataSources",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:GetOpenIDConnectProvider",
        "iam:ListOpenIDConnectProviders"
      ],
      "Resource": "*"
    },
    {
      "Sid": "TerraformState",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::__TF_STATE_BUCKET__",
        "arn:aws:s3:::__TF_STATE_BUCKET__/*"
      ]
    },
    {
      "Sid": "TerraformInfra",
      "Effect": "Allow",
      "Action": [
        "ec2:*",
        "elasticfilesystem:*",
        "ecr:*",
        "backup:*",
        "logs:*",
        "kms:Decrypt",
        "kms:Encrypt",
        "kms:GenerateDataKey",
        "kms:DescribeKey",
        "kms:CreateGrant",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "__AWS_REGION__"
        }
      }
    }
  ]
}
